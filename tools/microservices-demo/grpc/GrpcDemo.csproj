<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- A stand alone demo, not part of the solution. One project, two modes: server and client. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
    <!-- The one contract. The C# server base class and the client class are both generated from it at build time. -->
    <Protobuf Include="tasks.proto" GrpcServices="Both" />
  </ItemGroup>

</Project>

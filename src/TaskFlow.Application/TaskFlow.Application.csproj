<Project Sdk="Microsoft.NET.Sdk">

  <!-- Depends on the Domain and on NOTHING else. No EF Core, no ASP.NET. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskFlow.Domain\TaskFlow.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The logging ABSTRACTIONS only (ILogger<T>): no console, no provider.
         Which sink the messages reach is the host's decision, not this layer's. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

</Project>
